---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="foot-inner">
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
		<p class="powered">由 Astro 静态生成 · 内容通过 Keystatic 管理</p>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3.5em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85em;
	}
	.foot-inner {
		max-width: 720px;
		margin: 0 auto;
	}
	.copy {
		margin: 0 0 0.3em 0;
	}
	.powered {
		margin: 0;
		font-family: Consolas, monospace;
		font-size: 0.85em;
	}
</style>
